# (必需) 所有浏览器实例将要访问的统一目标 URL
CAMOUFOX_INSTANCE_URL="https://aistudio.google.com/apps/drive/xxxx"

# (可选) 浏览器运行模式。默认为 "virtual"。
# 可选值:
#   - "true": 完全无头模式，没有图形界面。
#   - "false": 正常模式，会显示浏览器窗口。
#   - "virtual": 虚拟显示模式，在无头环境下模拟一个显示器，兼容性最好。
# CAMOUFOX_HEADLESS="virtual"

# (可选) 设置代理服务器，支持HTTP/SOCKS。如果不需要代理，请将此行注释掉或留空。
# 格式: http://<user>:<password>@<host>:<port> 或 http://<host>:<port>
# CAMOUFOX_PROXY="http://proxy.example.com:8080"

# (可选) 每个 BrowserContext（账号实例）启动之间的延迟时间（秒），默认为 30 秒。
# 增加此值可以降低启动多个实例时的 CPU 峰值负载。
# INSTANCE_START_DELAY=30

# (可选) 单个账号实例的 Context 级最大重试次数，默认为 5 次。
# 达到上限后，该实例将停止重试并标记为终态。
# MAX_RESTART_RETRIES=5

# (可选) 共享浏览器级最大重启次数。默认与 MAX_RESTART_RETRIES 相同。
# 浏览器崩溃时，会重建浏览器并恢复所有可恢复的实例。
# MAX_BROWSER_RESTART_RETRIES=5

# (可选) 日志时区偏移量（小时）。默认为 8 (UTC+8 北京时间)。
# 设置为 0 即为 UTC 时间。
# TZ_OFFSET=8

# (可选) 项目根目录路径。通常不需要手动设置，程序会自动检测。
# 仅在特定的容器环境或自定义部署结构中需要。
# CAMOUFOX_PROJECT_ROOT="/app"

# (可选) 运行模式。
# 如果设置为 "true"，程序将以 Web 服务器模式运行（提供健康检查端点），适用于 HuggingFace Spaces。
# 如果未设置或为其他值，程序将以独立的 CLI 模式运行。
# HG="true"

# =====================================================================
# Cookie 远程集中管理
# =====================================================================
# (可选) 远程 Cookie JSON 地址（如 GitHub Secret Gist Raw URL）
# 格式：JSON 对象，每个 key 为账号名，value 为 Cookie-Editor 数组或 KV 字符串
# COOKIE_REMOTE_URL="https://gist.githubusercontent.com/<user>/<gist_id>/raw/cookies.json"
# (可选) 远程 Cookie 访问令牌。设置后使用 Bearer Token 认证。
# COOKIE_REMOTE_TOKEN=""
# (可选) 远程拉取超时（秒），默认 20。
# COOKIE_REMOTE_TIMEOUT=20
# (可选) 远程 Cookie 常规刷新间隔（秒），默认 3600 (1小时)。
# COOKIE_REFRESH_INTERVAL=3600
# (可选) Cookie 失效后恢复检查间隔（秒），默认 60。
# RECOVERY_CHECK_INTERVAL=60
# (可选) 多 Context 更新错峰间隔（秒），默认 3。
# COOKIE_CONTEXT_UPDATE_DELAY=3
# (可选) 远程拉取连续失败多少次后触发邮件告警，默认 3。
# COOKIE_REMOTE_FAILURE_ALERT_THRESHOLD=3


# =====================================================================
# Provider 标识 Cookie 注入
# =====================================================================
# 在多容器部署场景下，为每个账号的 WebSocket 连接注入标识 Cookie，
# 使网关能够识别连接来自哪个容器的哪个账号。
#
# 工作原理：
# 1. 系统为每个账号生成格式为 <前缀>_<账号名> 的标识值
# 2. 以 Cookie 形式注入到 BrowserContext 中
# 3. 浏览器向网关发起 WebSocket 握手时自动携带该 Cookie
# 4. 网关在 Upgrade 请求的 Cookie 头中读取标识
#
# 安全说明：该标识仅用于可观测性（日志、监控、故障排查），
# 不可用于身份认证或授权——任意客户端都可伪造该 Cookie 值。

# (可选) 是否启用 Provider 标识 Cookie 注入，默认 false。
# WS_LABEL_COOKIE_INJECTION="false"

# (可选) 注入的 Cookie 名称，支持逗号分隔的多个名称，默认 "provider_label"。
# 多个名称会与网关域名形成笛卡尔积，每个组合生成一条 Cookie。
# WS_LABEL_COOKIE_NAME="provider_label"

# (可选) WebSocket 网关域名，多个用逗号分隔。
# 只填写裸域名，不要包含协议、路径、端口。
# 示例:
#   WS_GATEWAY_DOMAINS="xxxx.onrender.com"
#   WS_GATEWAY_DOMAINS="xxxx.onrender.com,mycap.example.com"

# (可选) 容器前缀标识，默认 "default"。
# 多容器部署时必须为每个容器配置不同前缀，否则无法区分来源。
# 最终标识格式：<WS_LABEL_PREFIX>_<规范化账号文件名>
# 示例: WS_LABEL_PREFIX="ms01" + 账号 account7.json → ms01_account7_json
# WS_LABEL_PREFIX="ms01"

# =====================================================================
# 邮件通知（Gmail SMTP）
# =====================================================================
# (可选) 是否启用邮件通知，默认 false。
# NOTIFICATION_EMAIL_ENABLED=false
# (可选) SMTP 服务器与端口
# NOTIFICATION_EMAIL_SMTP_HOST="smtp.gmail.com"
# NOTIFICATION_EMAIL_SMTP_PORT=587
# (可选) 实例前缀标识，用于区分不同容器的通知邮件。
# NOTIFICATION_INSTANCE_PREFIX="hf-space-prod-a"
# (可选) 发件人地址。
# NOTIFICATION_EMAIL_FROM="yourname@gmail.com"
# (可选) 收件人地址，多个用逗号分隔。
# NOTIFICATION_EMAIL_TO="ops@example.com,admin@example.com"
# (可选) 同类告警最小间隔（秒），默认 1800 (30分钟)。
# NOTIFICATION_EMAIL_COOLDOWN=1800
# (可选) Gmail SMTP 用户名。
# EMAIL_SMTP_USER="yourname@gmail.com"
# (可选) Gmail SMTP 应用专用密码（非登录密码）。
# EMAIL_SMTP_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# =====================================================================
# 用户 Cookie 配置
# =====================================================================
# 至少需要一个有效 Cookie 来源：远程 URL / 环境变量 / cookies/ 目录文件。
#
# 环境变量格式：USER_COOKIE_<账号标识>
# 标识会规范化为 <标识>.json 作为本地文件名和账号唯一 ID。
# 支持 JSON 字符串（Cookie-Editor 导出格式）或 KV 字符串。
#
# 示例：
# USER_COOKIE_1='[{"name": "__Secure-1PSID", "value": "..."}]'
# USER_COOKIE_user1='__Secure-1PSID=...; __Secure-1PAPISID=...'
# USER_COOKIE_team_a='[{"name": "SID", "value": "..."}]'
